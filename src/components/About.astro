---
import { about, stats, education, experience, certificates } from '../data/profile';
---

<section id="about">
  <div class="container">
    <p class="section-label reveal">Tentang Saya</p>
    <div class="about-grid">
      <div class="reveal">
        <h2 class="section-title">Sedikit tentang saya</h2>
        {about.map((p) => <p class="text">{p}</p>)}
        <div class="stats">
          {
            stats.map((s) => (
              <div>
                <strong>{s.value}</strong>
                <span>{s.label}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="timeline-wrap">
        <div class="card timeline reveal">
          <h3>Pendidikan</h3>
          <ul>
            {
              education.map((e) => (
                <li>
                  <span class="period">{e.period}</span>
                  <strong>{e.title}</strong>
                  <span class="place">{e.place}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="card timeline reveal">
          <h3>Pengalaman</h3>
          <ul>
            {
              experience.map((c) => (
                <li>
                  <span class="period">{c.period}</span>
                  <strong>{c.title}</strong>
                  <span class="place">{c.place}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <h3 class="cert-heading reveal">Sertifikasi Kompetensi</h3>
    <div class="certs">
      {
        certificates.map((c) => (
          <a href={c.url} class="card cert reveal" target="_blank" rel="noopener">
            <div class="cert-top">
              <span class="badge">BNSP</span>
              <span class="cert-date">{c.date} · berlaku s.d. {c.validUntil}</span>
            </div>
            <strong class="cert-title">{c.title}</strong>
            <span class="cert-field">{c.field}</span>
            <span class="cert-issuer">{c.issuer}</span>
            <div class="tags">
              {c.units.map((u) => (
                <span class="tag">{u}</span>
              ))}
            </div>
            <span class="cert-link">Lihat sertifikat →</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
  }

  .text {
    color: var(--muted);
    margin: 0 0 16px;
  }

  .stats {
    display: flex;
    gap: 36px;
    margin-top: 36px;
    flex-wrap: wrap;
  }

  .stats strong {
    display: block;
    font-family: var(--font-head);
    font-size: 2.2rem;
    color: var(--text);
  }

  .stats span {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .timeline-wrap {
    display: grid;
    gap: 20px;
  }

  .timeline {
    padding: 26px 28px;
  }

  h3 {
    font-size: 1.1rem;
    margin-bottom: 16px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  li {
    display: grid;
    padding-left: 18px;
    border-left: 2px solid var(--border);
  }

  .period {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .place {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .cert-heading {
    font-size: 1.4rem;
    margin: 64px 0 20px;
  }

  .certs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }

  .cert {
    padding: 26px 28px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: radial-gradient(circle at 100% 0%, rgba(232, 176, 74, 0.1), transparent 55%), var(--card);
  }

  .cert:hover {
    transform: translateY(-4px);
  }

  .cert-link {
    margin-top: 14px;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .cert-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .badge {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--accent);
    color: #1a1408;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .cert-date {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .cert-title {
    font-family: var(--font-head);
    font-size: 1.35rem;
  }

  .cert-field {
    color: var(--text);
    font-size: 0.95rem;
  }

  .cert-issuer {
    color: var(--muted);
    font-size: 0.85rem;
    margin-bottom: 12px;
  }

  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
