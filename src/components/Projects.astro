---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { generalProjects } from '../data/profile';

// Proyek data (punya halaman studi kasus) ditampilkan lebih dulu, lalu proyek web
const dataProjects = (await getCollection('dataProjects'))
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.date.getTime() - a.data.date.getTime(),
  )
  .map((p) => ({
    category: 'Data',
    title: p.data.title,
    description: p.data.summary,
    highlight: p.data.highlights[0],
    tags: p.data.tools,
    image: p.data.cover,
    url: `/data/${p.id}/`,
    linkLabel: 'Lihat studi kasus',
  }));

const webProjects = generalProjects.map((p) => ({
  category: 'Web',
  title: p.title,
  description: p.description,
  highlight: undefined,
  tags: p.tags,
  image: p.image,
  url: p.url,
  linkLabel: 'Lihat di GitHub',
}));

const projects = [...dataProjects, ...webProjects];
---

<section id="projects" class="projects">
  <div class="container">
    <p class="section-label reveal">Proyek</p>
    <h2 class="section-title reveal">Proyek yang pernah saya kerjakan</h2>
    <p class="section-desc reveal">
      Dari analisis data dan machine learning hingga aplikasi web. Klik kartu untuk melihat studi
      kasus atau kode sumbernya.
    </p>

    <div class="grid">
      {
        projects.map((p) => (
          <a
            href={p.url}
            class="card project reveal"
            target={p.url.startsWith('http') ? '_blank' : undefined}
            rel="noopener"
          >
            {p.image && (
              <div class="cover">
                <Image src={p.image} alt="" widths={[480, 800]} sizes="(max-width: 860px) 100vw, 33vw" />
              </div>
            )}
            <div class="body">
              <span class:list={['category', p.category.toLowerCase()]}>{p.category}</span>
              <h3>{p.title}</h3>
              <p>{p.description}</p>
              {p.highlight && <p class="highlight">{p.highlight}</p>}
              <div class="tags">
                {p.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
              <span class="more">{p.linkLabel} →</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects {
    background: linear-gradient(to bottom, transparent, rgba(18, 21, 28, 0.7) 15%, rgba(18, 21, 28, 0.7) 85%, transparent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 22px;
  }

  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .project:hover {
    transform: translateY(-4px);
  }

  .cover {
    aspect-ratio: 800 / 420;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }

  .project:hover .cover :global(img) {
    transform: scale(1.04);
  }

  .body {
    padding: 22px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .category {
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .category.data {
    background: rgba(74, 143, 232, 0.15);
    color: #8bb8f2;
  }

  .category.web {
    background: rgba(232, 176, 74, 0.15);
    color: var(--accent);
  }

  h3 {
    font-size: 1.2rem;
  }

  .body p {
    color: var(--muted);
    margin: 0;
    font-size: 0.93rem;
  }

  .body .highlight {
    color: var(--text);
    font-size: 0.88rem;
    padding-left: 12px;
    border-left: 2px solid var(--accent);
  }

  .more {
    margin-top: auto;
    padding-top: 6px;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
