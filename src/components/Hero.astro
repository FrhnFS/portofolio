---
import { Image } from 'astro:assets';
import foto from '../assets/foto-profil.jpg';
import { profile } from '../data/profile';
---

<section id="home" class="hero">
  <div class="container hero-grid">
    <div class="hero-text">
      {
        profile.available && (
          <p class="status">
            <span class="dot" /> Terbuka untuk pekerjaan
          </p>
        )
      }
      <p class="role">{profile.role}</p>
      <h1>{profile.name}</h1>
      <p class="tagline">{profile.tagline}</p>
      <div class="actions">
        <a href="#data" class="btn btn-primary">Lihat Proyek Data</a>
        {profile.cvUrl && <a href={profile.cvUrl} class="btn" download>Download CV</a>}
      </div>
    </div>

    <div class="hero-photo">
      <div class="photo-frame">
        <Image
          src={foto}
          alt={`Foto ${profile.name}`}
          width={720}
          widths={[320, 480, 720]}
          sizes="(max-width: 860px) 280px, 400px"
          loading="eager"
          fetchpriority="high"
          quality={80}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 60px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--muted);
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    margin: 0 0 28px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 0 4px rgba(74, 222, 128, 0.2);
  }

  .role {
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.08em;
    margin: 0 0 10px;
  }

  h1 {
    font-size: clamp(2.6rem, 7vw, 4.8rem);
    letter-spacing: -0.02em;
  }

  .tagline {
    color: var(--muted);
    font-size: 1.1rem;
    max-width: 520px;
    margin: 22px 0 36px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-photo {
    display: flex;
    justify-content: center;
  }

  .photo-frame {
    position: relative;
    width: min(100%, 380px);
    aspect-ratio: 3 / 4;
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }

  .photo-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(11, 13, 18, 0.55), transparent 45%);
  }

  .photo-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Animasi masuk saat halaman dibuka */
  .hero-text > *,
  .photo-frame {
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero-text > :nth-child(2) { animation-delay: 0.08s; }
  .hero-text > :nth-child(3) { animation-delay: 0.16s; }
  .hero-text > :nth-child(4) { animation-delay: 0.24s; }
  .hero-text > :nth-child(5) { animation-delay: 0.32s; }
  .photo-frame { animation-delay: 0.2s; }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }
    .hero-photo {
      order: -1;
    }
    .photo-frame {
      width: 240px;
    }
    .tagline {
      margin-inline: auto;
    }
    .actions {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-text > *,
    .photo-frame {
      animation: none;
    }
  }
</style>
