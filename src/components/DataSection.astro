---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const projects = (await getCollection('dataProjects')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    b.data.date.getTime() - a.data.date.getTime(),
);

// Tinggi batang hiasan untuk kartu tanpa gambar cover
const bars = [40, 65, 50, 85, 60, 95, 72];
---

<section id="data" class="data">
  <div class="container">
    <p class="section-label reveal">Portfolio Data Analyst</p>
    <h2 class="section-title reveal">Studi kasus analisis data</h2>
    <p class="section-desc reveal">
      Proyek analisis dari pembersihan data hingga insight dan rekomendasi. Klik kartu untuk
      melihat proses lengkap dan dashboard-nya.
    </p>

    <div class="grid">
      {
        projects.map((p) => (
          <a href={`/data/${p.id}/`} class:list={['card', 'project', 'reveal', { featured: p.data.featured }]}>
            <div class="cover">
              {p.data.cover ? (
                <Image src={p.data.cover} alt="" widths={[480, 800]} sizes="(max-width: 860px) 100vw, 50vw" />
              ) : (
                <div class="chart" aria-hidden="true">
                  {bars.map((h) => (
                    <span style={`height:${h}%`} />
                  ))}
                </div>
              )}
            </div>
            <div class="body">
              <h3>{p.data.title}</h3>
              <p>{p.data.summary}</p>
              {p.data.highlights[0] && <p class="highlight">{p.data.highlights[0]}</p>}
              <div class="tags">
                {p.data.tools.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
              <span class="more">Lihat studi kasus →</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .data {
    background: linear-gradient(to bottom, transparent, rgba(18, 21, 28, 0.7) 20%, rgba(18, 21, 28, 0.7) 80%, transparent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .project:hover {
    transform: translateY(-4px);
  }

  .cover {
    aspect-ratio: 16 / 8;
    background: linear-gradient(135deg, #1b2130, #121620);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }

  .project:hover .cover :global(img) {
    transform: scale(1.04);
  }

  .chart {
    height: 100%;
    display: flex;
    align-items: flex-end;
    gap: 10px;
    padding: 28px 32px 0;
  }

  .chart span {
    flex: 1;
    border-radius: 6px 6px 0 0;
    background: linear-gradient(to top, rgba(74, 143, 232, 0.25), rgba(74, 143, 232, 0.7));
    transform-origin: bottom;
    transition: transform 0.4s;
  }

  .chart span:nth-child(6) {
    background: linear-gradient(to top, rgba(232, 176, 74, 0.35), var(--accent));
  }

  .project:hover .chart span {
    transform: scaleY(1.06);
  }

  .body {
    padding: 24px 26px 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  h3 {
    font-size: 1.3rem;
  }

  .body p {
    color: var(--muted);
    margin: 0;
    font-size: 0.95rem;
  }

  .body .highlight {
    color: var(--text);
    font-size: 0.9rem;
    padding-left: 12px;
    border-left: 2px solid var(--accent);
  }

  .more {
    margin-top: auto;
    padding-top: 6px;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
